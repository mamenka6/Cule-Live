rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Roles: @mamenka6 (the app's creator) is always an owner. Others are in /roles/{uid} as 'owner' or 'admin'.
    // Owners do everything. Admins do everything except take admin away from someone or make owners.
    function founder() { return 'ADVyrwkXjyQK7zUJAxqrDzHuasm2'; }
    function roleOf(uid) { return exists(/databases/$(database)/documents/roles/$(uid)) ? get(/databases/$(database)/documents/roles/$(uid)).data.role : ''; }
    function isOwner() { return request.auth != null && (request.auth.uid == founder() || roleOf(request.auth.uid) == 'owner'); }
    function isAdmin() { return request.auth != null && (isOwner() || roleOf(request.auth.uid) == 'admin'); }
    function isStaff(uid) { return uid == founder() || roleOf(uid) in ['owner', 'admin']; }
    function isBanned(uid) { return exists(/databases/$(database)/documents/bans/$(uid)); }
    function isMuted(uid) { return exists(/databases/$(database)/documents/mutes/$(uid)) && get(/databases/$(database)/documents/mutes/$(uid)).data.until > request.time.toMillis(); }

    // Each person's own predictions (unchanged)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, delete: if isAdmin() && !isStaff(uid);  // admins deleting an account
    }

    // Member records ("profiles"): everyone has one. Guests get "Guest 1234" (@guest1234) until they choose a name.
    // Anyone can see them; each person edits only their own, admins can edit anyone's; always with a username reserved below
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'username', 'at', 'guest', 'createdAt', 'lastSeen'])
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 30
        && d.username is string && d.username.matches('^[a-z0-9_.]{3,20}$')
        && (!d.username.matches('^guest[0-9]+$') || d.get('guest', false) == true)
        && !d.displayName.lower().matches('.*(fuck|bitch|cunt|nigger|nigga|faggot|whore|motherf|putain|salope|mierda|gilipollas|qahba|9a7ba).*')
        && !d.username.matches('.*(fuck|bitch|cunt|nigger|nigga|faggot|whore|motherf|putain|salope|mierda|gilipollas|qahba|9a7ba).*');
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAdmin())
        && validProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());  // anyone can delete their own account
    }

    // Usernames: one person per username. A taken name can't be claimed (that would be an update),
    // and only its owner (or an admin) can free it
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Fan chat: anyone can read; signed-in people post only as themselves, with their own profile name
    match /chat/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'  // guests can read, not post
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('guest', false) != true
        && request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && !request.resource.data.text.lower().matches('.*(fuck|bitch|cunt|nigger|nigga|faggot|whore|motherf|putain|salope|mierda|gilipollas|qahba|9a7ba).*')  // the worst swear words, also blocked in the app
        && request.resource.data.at == request.time
        && request.resource.data.name == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && request.resource.data.username == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && !isBanned(request.auth.uid) && !isMuted(request.auth.uid);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Roles list: public (so the app shows badges). Admins can make admins; only owners can make owners
    // or take a role away. The creator's owner role can't be changed.
    match /roles/{uid} {
      allow read: if true;
      allow create: if uid != founder() && request.resource.data.keys().hasOnly(['role', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && ((request.resource.data.role == 'admin' && isAdmin()) || (request.resource.data.role == 'owner' && isOwner()));
      allow update: if uid != founder() && isOwner() && request.resource.data.keys().hasOnly(['role', 'by', 'at'])
        && request.resource.data.role in ['admin', 'owner'];
      allow delete: if uid != founder() && isOwner();
    }

    // Bans and mutes: everyone can see them (so the app knows), only admins can change them,
    // and nobody can ban or mute an admin or owner (take their role away first)
    match /bans/{uid} {
      allow read: if true;
      allow write: if isAdmin() && uid != request.auth.uid && !isStaff(uid);
    }
    match /mutes/{uid} {
      allow read: if true;
      allow write: if isAdmin() && uid != request.auth.uid && !isStaff(uid);
    }

    // Feedback: anyone signed in (guests too) can send; only admins can read or delete it
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username', 'kind', 'text', 'platform', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 1000
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 20
        && request.resource.data.at is number;
      allow read, delete: if isAdmin();
    }

    // Each player's prediction points, public so league tables can show them
    match /stats/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pts', 'n', 'exact', 'done', 'streak', 'name', 'username', 'at'])
        && request.resource.data.pts is int && request.resource.data.n is int
        && request.resource.data.exact is int && request.resource.data.done is int
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.username is string && request.resource.data.username.size() <= 20;
      allow delete: if isAdmin();
    }

    // Prediction leagues: signed-in people can see them, create one, join or leave by code
    match /leagues/{code} {
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30
        && !request.resource.data.name.lower().matches('.*(fuck|bitch|cunt|nigger|nigga|faggot|whore|motherf|putain|salope|mierda|gilipollas|qahba|9a7ba).*');
      allow update: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() <= 50
        && (
          // joining: add only yourself
          (request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members))
          ||
          // leaving: remove only yourself
          (request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members))
        );
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Reported chat messages: signed-in people report, admins read and clear
    match /reports/{id} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['msgId', 'uid', 'username', 'text', 'reason', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40;
      allow read, delete: if isAdmin();
    }

    // Fan polls: one vote per signed-in person per match
    match /polls/{pid}/votes/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['pick', 'at'])
        && request.resource.data.pick is string && request.resource.data.pick.size() <= 40;
    }

    // League chat: only members of that league can read or post
    match /leagues/{code}/chat/{id} {
      function member() { return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/leagues/$(code)).data.members; }
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
        && !request.resource.data.text.lower().matches('.*(fuck|bitch|cunt|nigger|nigga|faggot|whore|motherf|putain|salope|mierda|gilipollas|qahba|9a7ba).*')
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // News posts by admins (photos stored as compressed images in /imgs)
    match /posts/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000;
      allow delete: if isAdmin();
      match /imgs/{n} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Admin fan polls (Home / News / Matches / Chat): one vote per signed-in person
    match /apolls/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.q is string && request.resource.data.q.size() <= 120 && request.resource.data.opts.size() <= 6;
      allow delete: if isAdmin();
      match /votes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly(['i', 'at']) && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 6;
        allow delete: if isAdmin();
      }
    }

    // Player of the match fan vote: one vote per person per match, results public
    match /potm/{matchId}/votes/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['pid', 'name', 'at'])
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
